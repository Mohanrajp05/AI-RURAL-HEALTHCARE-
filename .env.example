# Copy this file to .env.local (Vite convention) and fill in real values.
# .env.local itself is gitignored and must never be committed -- this
# .env.example is the only one of the two meant to be committed.
#
# Only VITE_-prefixed vars are exposed to the browser bundle -- never put
# a backend-only secret (Supabase service_role key, MySQL password, etc.)
# in here.

# Supabase project URL + anon key. The anon key is safe to expose
# client-side by design (protected by Row Level Security) -- this is NOT
# the service_role key, which belongs only in backend/.env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps JavaScript API key -- backs the location-confirmation map
# widget only (AIAssistant.tsx). Hospital search itself and address
# geocoding run server-side against Overpass/Nominatim, not Google.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API origin. Leave unset for local dev (defaults to
# http://localhost:5001 / http://127.0.0.1:5001 in code) -- set this to
# your deployed Render backend URL for production.
VITE_BACKEND_URL=http://localhost:5001
