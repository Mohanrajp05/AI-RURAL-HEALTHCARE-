# Copy this file to backend/.env and fill in real values.
# backend/.env itself is gitignored and must never be committed --
# this .env.example is the only one of the two meant to be committed.

FLASK_ENV=production
FLASK_DEBUG=False

########## MySQL (user profile store) ##########
# Registration/profile data only (full_name, email, role) -- Supabase
# remains the system of record for actual auth.
MYSQL_HOST=your_mysql_host_here
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user_here
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=rural_healthcare

########## Website email (feedback form, notifications) ##########
SMTP_EMAIL=your_smtp_email_here
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

########## Admin / doctor dashboard login ##########
# Leave a password unset (blank) to disable that login entirely rather
# than fall back to a guessable default -- see app.py.
ADMIN_EMAIL=admin@ruralhealthcare.com
ADMIN_PASSWORD=your_admin_password_here
DOCTOR_EMAIL=doctor@ruralhealthcare.com
DOCTOR_PASSWORD=your_doctor_password_here

########## Supabase (server-side only) ##########
# Service-role key -- NEVER expose this client-side / in any VITE_
# variable. Used by supabase_admin.py to list registered users directly
# from Supabase Auth. VITE_SUPERBASE_URL below is shared with the
# frontend project URL (same value, safe to reuse).
VITE_SUPERBASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

########## Portkey AI Gateway (LLM routing) ##########
PORTKEY_GATEWAY_KEY=your_portkey_gateway_key_here
# One SLUG/MODEL pair per provider you've added in the Portkey Model
# Catalog -- add or remove PORTKEY_<NAME>_SLUG / PORTKEY_<NAME>_MODEL
# pairs as needed, portkey_config.py discovers them automatically.
PORTKEY_GEMINI_SLUG=your_gemini_slugs_csv_here
PORTKEY_GEMINI_MODEL=gemini-3.1-flash-lite
PORTKEY_GROQ_SLUG=your_groq_slugs_csv_here
PORTKEY_GROQ_MODEL=openai/gpt-oss-20b

########## Direct Groq (optional fallback tier, outside Portkey) ##########
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
