def _connect_mongo(force_reconnect: bool = False):
    """Create/refresh MongoDB connection and return patients collection or None."""
    global _mongo_client, _db, patients_col

    if force_reconnect:
        _mongo_client = None
        _db = None
        patients_col = None

    if patients_col is not None and _mongo_client is not None:
        try:
            _mongo_client.admin.command("ping")
            return patients_col
        except Exception:
            _mongo_client = None
            _db = None
            patients_col = None

    def _build_client_kwargs(uri: str, allow_invalid_certs: bool = False):
        kwargs = {
            "serverSelectionTimeoutMS": 5000,
            "connectTimeoutMS": 10000,
            "socketTimeoutMS": 20000,
            "retryWrites": True,
        }

        use_tls = str(uri).startswith("mongodb+srv://")

        certifi_path = None
        try:
            import importlib
            certifi_module = importlib.import_module("certifi")
            certifi_path = certifi_module.where()
        except Exception:
            certifi_path = None

        if use_tls and certifi_path:
            kwargs["tls"] = True
            kwargs["tlsCAFile"] = certifi_path

        if use_tls and allow_invalid_certs:
            kwargs["tls"] = True
            kwargs["tlsAllowInvalidCertificates"] = True
            kwargs.pop("tlsCAFile", None)

        return kwargs

    allow_invalid_env = str(os.environ.get("MONGO_TLS_ALLOW_INVALID_CERTS", "0")).lower() in {"1", "true", "yes"}
    candidate_uris = [MONGO_URI]
    if MONGO_FALLBACK_URI and MONGO_FALLBACK_URI not in candidate_uris:
        candidate_uris.append(MONGO_FALLBACK_URI)

    last_error = None
    for idx, uri in enumerate(candidate_uris):
        is_fallback = idx > 0
        attempts = [False]
        if str(uri).startswith("mongodb+srv://"):
            if allow_invalid_env:
                attempts = [True]
            else:
                attempts = [False, True]

        for allow_invalid in attempts:
            try:
                _mongo_client = MongoClient(uri, **_build_client_kwargs(uri, allow_invalid))
                _mongo_client.admin.command("ping")
                _db = _mongo_client[MONGO_DB_NAME]
                patients_col = _db["patients"]

                if is_fallback:
                    print(f" Connected to MongoDB fallback at {uri}")
                elif allow_invalid:
                    print(" Connected to MongoDB Atlas (tlsAllowInvalidCertificates enabled)")
                else:
                    print(" Connected to MongoDB Atlas")
                return patients_col
            except Exception as _mongo_err:
                last_error = _mongo_err
                _mongo_client = None
                _db = None
                patients_col = None

    print(f"✗ MongoDB connection failed: {last_error}")
    return None

