def detect_language(query: str) -> str:
    q = str(query or "").lower()
    if any(w in q for w in [
            "kannada", "in kannada", "into kannada",
            "kannada alli", "kannadadalli"]):
        return "kan_Knda"
    elif any(w in q for w in [
            "hindi", "in hindi", "into hindi",
            "hindi me", "hindi mein"]):
        return "hin_Deva"
    if any('\u0C80' <= c <= '\u0CFF' for c in str(query or "")):
        return "kan_Knda"
    if any('\u0900' <= c <= '\u097F' for c in str(query or "")):
        return "hin_Deva"
    return "eng_Latn"


def is_translation_query(query: str) -> bool:
    keywords = [
        "translate", "in hindi", "into hindi",
        "hindi me", "hindi mein", "in kannada",
